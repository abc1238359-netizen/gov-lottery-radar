---
import { CATEGORIES, computeStatus, md, stubText, urgency, type Lottery } from '../lib/status';

interface Props {
  item: Lottery;
  today: string;
  expanded?: boolean;
  linkTitle?: boolean;
}

const { item, today, expanded = false, linkTitle = true } = Astro.props;
const c = computeStatus(item, today);
const s = stubText(c, item);
const u = urgency(c);
const cat = CATEGORIES[item.category];
const where = item.level === 'central' ? '全國' : item.region;
const crossYear = item.endDate.slice(0, 4) !== item.startDate.slice(0, 4);
const period =
  `${md(item.startDate)}–${crossYear ? `${item.endDate.slice(0, 4)}/` : ''}${md(item.endDate)}` +
  (item.registerDeadline && item.registerDeadline !== item.endDate ? `，登錄到 ${md(item.registerDeadline)}` : '');
---
<article
  class="ticket"
  data-id={item.id}
  data-category={item.category}
  data-level={item.level}
  data-status={c.status}
  id={`t-${item.id}`}
>
  <div class="stub" data-urgency={u} aria-label={`${s.top}${s.num}${s.unit}，${s.foot}`}>
    <span class="stub-top" aria-hidden="true">{s.top}</span>
    <span class="stub-num" aria-hidden="true" data-word={/^\d+$/.test(s.num) ? undefined : ''}>{s.num}</span>
    <span class="stub-unit" aria-hidden="true">{s.unit}</span>
    <span class="stub-foot" aria-hidden="true">{s.foot}</span>
  </div>
  <div class="body">
    <p class="meta">
      <span class="cat" style={`--c: var(--cat-${item.category})`}>{cat.label}</span>
      <span class="where">{where}</span>
      {item.audience === 'foreigners' && <span class="flag">限外籍旅客</span>}
    </p>
    <h3 class="title">
      {linkTitle ? <a href={`/l/${item.id}/`}>{item.title}</a> : item.title}
    </h3>
    <p class="org">{item.organizer}</p>
    <dl class="facts">
      <div><dt>最大獎</dt><dd>{item.topPrize}</dd></div>
      <div><dt>誰能參加</dt><dd>{item.eligibility}</dd></div>
    </dl>
    <details open={expanded}>
      <summary>怎麼參加、什麼時候開獎</summary>
      <dl class="facts more">
        <div><dt>參加方式</dt><dd>{item.howToJoin}</dd></div>
        <div>
          <dt>活動期間</dt>
          <dd>{period}</dd>
        </div>
        <div><dt>開獎</dt><dd>{item.drawDate ? `${md(item.drawDate)}。` : ''}{item.drawNote}</dd></div>
        <div>
          <dt>資料來源</dt>
          <dd>
            <a href={item.sourceUrl} rel="noopener" target="_blank">{item.sourceNote}</a>，{md(item.lastVerified)} 查證
          </dd>
        </div>
      </dl>
    </details>
    <p class="actions">
      <a class="go" href={item.officialUrl} rel="noopener" target="_blank">前往官方網站</a>
      {item.winnersUrl && <a class="winners" href={item.winnersUrl} rel="noopener" target="_blank">中獎名單</a>}
    </p>
  </div>
</article>

<style>
  .ticket {
    --notch: 9px;
    position: relative;
    display: grid;
    grid-template-columns: 92px 1fr;
    background: var(--surface);
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .ticket[hidden] { display: none; }

  /* 票根：顏色代表急迫程度，右側是撕線 */
  .stub {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 18px 6px;
    color: #fff;
    background: var(--stub-calm);
    text-align: center;
    border-right: 2px dashed color-mix(in srgb, var(--bg) 85%, transparent);
  }
  .stub[data-urgency='urgent'] { background: var(--urgent); }
  .stub[data-urgency='soon'] { background: #f0b23a; color: #2a1d00; }
  .stub[data-urgency='muted'] { background: var(--stub-muted); }
  .stub::before,
  .stub::after {
    content: '';
    position: absolute;
    right: calc(var(--notch) * -1 - 1px);
    width: calc(var(--notch) * 2);
    height: calc(var(--notch) * 2);
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .stub::before { top: calc(var(--notch) * -1 - 1px); }
  .stub::after { bottom: calc(var(--notch) * -1 - 1px); }

  .stub-top { font-size: 0.8125rem; line-height: 1; opacity: 0.9; min-height: 0.8125rem; }
  .stub-num {
    font-family: var(--font-num);
    font-weight: 700;
    font-size: 2.75rem;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .stub-num[data-word] { font-family: var(--font-body); font-size: 1.625rem; font-weight: 700; letter-spacing: 0.02em; }
  .stub-unit { font-size: 0.875rem; font-weight: 500; line-height: 1.3; }
  .stub-foot {
    margin-top: 8px;
    font-family: var(--font-num);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.2;
    opacity: 0.92;
  }

  .body { padding: 14px 16px 14px 20px; min-width: 0; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin: 0 0 4px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--c);
    font-weight: 500;
  }
  .cat::before {
    content: '';
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--c);
  }
  .flag {
    color: var(--soon);
    font-weight: 500;
  }
  .title {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.4;
    font-weight: 700;
  }
  .title a { text-decoration: none; }
  .title a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .org { margin: 2px 0 10px; font-size: 0.875rem; color: var(--muted); }

  .facts { margin: 0; display: grid; gap: 6px; }
  .facts div { display: grid; grid-template-columns: 4.5em 1fr; gap: 8px; }
  .facts dt { font-size: 0.8125rem; color: var(--muted); padding-top: 2px; }
  .facts dd { margin: 0; font-size: 0.9375rem; }

  details { margin-top: 10px; }
  summary {
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--calm);
    font-weight: 500;
    padding: 4px 0;
    list-style-position: inside;
  }
  .more { margin-top: 8px; padding: 10px 12px; background: var(--surface-2); border-radius: 10px; }
  .more a { color: var(--calm); }

  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 0; }
  .go, .winners {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .go { background: var(--ink); color: var(--surface); }
  .winners { border: 1px solid var(--line); color: var(--ink); }

  @media (max-width: 420px) {
    .ticket { grid-template-columns: 78px 1fr; }
    .stub-num { font-size: 2.375rem; }
    .body { padding: 12px 12px 12px 16px; }
    .facts div { grid-template-columns: 1fr; gap: 0; }
  }
</style>
